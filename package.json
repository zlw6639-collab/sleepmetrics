{
  "name": "sleepmetrics",
  "version": "0.3.0",
  "description": "Standard sleep metrics in pure JavaScript: sleep regularity index (SRI) and circadian phase (MSFsc / social jetlag). Zero dependencies, no build step, no network, no filesystem.",
  "type": "module",
  "license": "MIT",
  "author": "猫咖没有猫猫",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zlw6639-collab/sleepmetrics.git"
  },
  "homepage": "https://github.com/zlw6639-collab/sleepmetrics#readme",
  "bugs": {
    "url": "https://github.com/zlw6639-collab/sleepmetrics/issues"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "bin": {
    "sleepmetrics": "bin/sleepmetrics.js"
  },
  "files": [
    "src",
    "data",
    "bin",
    "README.md",
    "REFERENCES.md",
    "SLEEP-FACTS.md",
    "PUSHING-TO-YOUR-PHONE.md",
    "TIMESTAMPS.md",
    "CHANGELOG.md",
    "HOLIDAYS.md",
    "DISCLAIMER.md",
    "ROADMAP.md",
    "NON-GOALS.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node scripts/test-all.mjs",
    "test:anchors": "node test/anchor-synthetic.test.js",
    "test:one": "node test/sri.test.js",
    "regression": "node test/regression.test.js",
    "check:links": "node scripts/check-links.mjs",
    "smoke": "node scripts/pack-smoke.mjs"
  },
  "keywords": [
    "sleep",
    "actigraphy",
    "sri",
    "sleep-regularity",
    "msfsc",
    "mctq",
    "chronotype",
    "social-jetlag",
    "circadian"
  ],
  "dependencies": {}
}
