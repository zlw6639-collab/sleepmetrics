license: MIT
version: 0.1.1
date-released: "2026-10-14"
repository-code: "https://github.com/zlw6639-collab/sleepmetrics"
url: "https://github.com/zlw6639-collab/sleepmetrics"
keywords:
  - sleep
  - actigraphy
  - sleep-regularity
  - sri
  - circadian-rhythm
  - social-jetlag
  - msfsc
  - sleep-metrics
